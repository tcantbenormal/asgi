---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AdSlot from '../components/AdSlot.astro';
import { ads } from '../config/ads';
import { site } from '../config/site';

interface Props {
  title: string;
  description?: string;
  /** Show the right-hand ad rail. Default true. */
  rail?: boolean;
  /** Exclude from Pagefind search index. */
  noindex?: boolean;
  /** Open Graph image. Defaults to a per-section card from /og/ chosen by the first path segment. */
  image?: string;
}
const { title, description = site.tagline, rail = true, noindex = false, image } = Astro.props;
const OG_SECTIONS = ['alumni', 'map', 'forum', 'stories', 'roadmaps', 'software', 'datasets', 'opportunities', 'industry', 'projects', 'society', 'events', 'mentorship'];
const seg = Astro.url.pathname.replace(/\.html$/, '').split('/')[1] || '';
const ogImage = new URL(image ?? `/og/${OG_SECTIONS.includes(seg) ? seg : 'default'}.png`, Astro.site);
const fullTitle = title === site.name ? title : `${title} · ${site.short}`;
const canonical = new URL(Astro.url.pathname.replace(/(\/index)?\.html$/, '') || '/', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {ads.verification && <Fragment set:html={ads.verification} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main data-pagefind-body={noindex ? undefined : ''} data-pagefind-ignore={noindex ? '' : undefined}>
      {rail ? (
        <div class="wrap with-rail" style="padding-top:0">
          <div><slot /></div>
          <aside class="rail" aria-label="Sponsored" data-pagefind-ignore>
            <AdSlot slot="sidebar" />
          </aside>
        </div>
      ) : (
        <slot />
      )}
    </main>
    <div class="wrap" data-pagefind-ignore><AdSlot slot="footer" /></div>
    <Footer />
    <script is:inline>
      // Every link to another site opens in a new tab, including links rendered later (forum, replies).
      document.addEventListener('click', (e) => {
        const a = e.target.closest('a[href]');
        if (!a || a.target || a.hasAttribute('download')) return;
        if (a.origin && a.origin !== location.origin && /^https?:$/.test(a.protocol)) { a.target = '_blank'; a.rel = 'noopener'; }
      }, true);
    </script>
  </body>
</html>
