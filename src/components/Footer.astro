---
import { site } from '../config/site';
const year = new Date().getFullYear();
const socials = [['LinkedIn', site.social.linkedin], ['Facebook', site.social.facebook], ['Instagram', site.social.instagram]].filter(([, u]) => u && !u.includes('REPLACE'));
---
<footer class="site-footer" data-pagefind-ignore>
  <div class="wrap">
    <div class="cols">
      <div>
        <h4>{site.name}</h4>
        <p>{site.department}<br />{site.university}</p>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <div>
        <h4>Alumni</h4>
        <ul>
          <li><a href="/alumni">Directory</a></li>
          <li><a href="/map">Alumni map</a></li>
          <li><a href="/stories">Stories</a></li>
          <li><a href="/account">Account</a></li>
          <li><a href="/join">Join ASGI</a></li>
          <li><a href="/mentorship">Mentorship</a></li>
        </ul>
      </div>
      <div>
        <h4>Learn</h4>
        <ul>
          <li><a href="/roadmaps">Skills roadmaps</a></li>
          <li><a href="/software">Software</a></li>
          <li><a href="/datasets">Datasets</a></li>
          <li><a href="/opportunities">Scholarships and jobs</a></li>
          <li><a href="/industry">Industry</a></li>
          <li><a href="/projects">FYP archive</a></li>
        </ul>
      </div>
      <div>
        <h4>Society</h4>
        <ul>
          <li><a href="/society">About and cabinet</a></li>
          <li><a href="/events">Events</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/privacy">Privacy policy</a></li>
          <li><a href="/legal">Content policy</a></li>
        </ul>
      </div>
    </div>
    <div class="legal">
      <span>© {year} {site.name}. Conceived, designed and built by <a href="/tcantbenormal">Muhammad Taimoor Ashfaq Malik</a>. Contributor: Fahad Karim.</span>
      <span>{socials.map(([label, u], i) => <>{i > 0 && ' · '}<a href={u} rel="noopener">{label}</a></>)}</span>
    </div>
  </div>
</footer>
