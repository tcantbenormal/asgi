---
import { ads, type AdSlotName } from '../config/ads';
interface Props { slot: AdSlotName }
const { slot } = Astro.props;
const html = ads[slot];
---
{html
  ? <div class={`ad ${slot} filled`} set:html={html} />
  : import.meta.env.DEV && <div class={`ad ${slot}`} aria-hidden="true">Ad space · {slot}</div>}
