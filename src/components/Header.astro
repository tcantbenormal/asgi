---
import { site } from '../config/site';
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/$/, '') || '/'; // build.format 'file' gives /stories.html
// Four groups instead of twelve flat links. Each group is a native <details>, so it works without JS.
const groups: [string, [string, string][]][] = [
  ['Community', [['/alumni', 'Alumni directory'], ['/map', 'Alumni map'], ['/forum', 'Forum'], ['/mentorship', 'Mentorship']]],
  ['Learn', [['/roadmaps', 'Roadmaps'], ['/stories', 'Stories'], ['/software', 'Software'], ['/datasets', 'Datasets'], ['/projects', 'FYP archive']]],
  ['Careers', [['/opportunities', 'Opportunities'], ['/industry', 'Industry']]],
  ['Society', [['/society', 'About and cabinet'], ['/events', 'Events'], ['/whats-new', "What's new"], ['/contact', 'Contact']]],
];
const current = (href: string) => (path === href || path.startsWith(href + '/') ? 'page' : undefined);
const inGroup = (links: [string, string][]) => links.some(([h]) => current(h));
---
<header class="site-header" data-pagefind-ignore>
  <div class="wrap">
    <a href="/" class="brand" aria-label={`${site.name} home`}>
      <img src="/img/logo.jpg" alt="" width="46" height="46" />
      <span class="brand-name">Arid Society<br />of GIS</span>
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="nav">Menu</button>
    <nav class="nav" id="nav" aria-label="Main">
      {groups.map(([label, links]) => (
        <details class="menu" data-on={inGroup(links) ? '' : undefined}>
          <summary>{label}</summary>
          <div class="menu-list">
            {links.map(([href, text]) => <a href={href} aria-current={current(href)}>{text}</a>)}
          </div>
        </details>
      ))}
      <form class="nav-search" action="/search" role="search">
        <input type="search" name="q" placeholder="Search" aria-label="Search the portal" />
      </form>
      <span class="auth" id="hdr-auth">
        <a href="/account" aria-current={current('/account')}>Sign in</a>
        <a href="/join" class="cta">Sign up</a>
      </span>
    </nav>
  </div>
</header>
<script is:inline define:vars={{ url: site.supabase.url, apikey: site.supabase.key }}>
  // Reads the session supabase-js keeps in localStorage so every page knows who is signed in,
  // without loading the library. Sign-out calls the auth endpoint directly, then clears the key.
  (() => {
    const storageKey = `sb-${new URL(url).hostname.split('.')[0]}-auth-token`;
    let s; try { s = JSON.parse(localStorage.getItem(storageKey) || 'null'); } catch {}
    const u = s && s.user; if (!u) return;
    const m = u.user_metadata || {}, box = document.getElementById('hdr-auth');
    box.textContent = '';
    const me = document.createElement('a'); me.href = '/account'; me.className = 'me';
    const pic = m.avatar_url || m.picture;
    if (pic) { const i = document.createElement('img'); i.src = pic; i.alt = ''; i.width = 26; i.height = 26; me.appendChild(i); }
    me.appendChild(document.createTextNode((m.full_name || m.name || u.email).split(' ')[0]));
    const out = document.createElement('button'); out.type = 'button'; out.className = 'signout'; out.textContent = 'Sign out';
    out.onclick = async () => {
      try { await fetch(`${url}/auth/v1/logout`, { method: 'POST', headers: { apikey, Authorization: `Bearer ${s.access_token}` } }); } catch {}
      localStorage.removeItem(storageKey); location.href = '/';
    };
    box.append(me, out);
  })();
</script>
<script>
  const btn = document.querySelector('.nav-toggle');
  const nav = document.getElementById('nav');
  btn?.addEventListener('click', () => {
    const open = nav!.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
  });
  // One dropdown open at a time; close on outside click or Escape.
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('.nav .menu')];
  menus.forEach((m) => m.addEventListener('toggle', () => { if (m.open) menus.forEach((o) => o !== m && (o.open = false)); }));
  document.addEventListener('click', (e) => { if (!(e.target as Element).closest('.nav .menu')) menus.forEach((m) => (m.open = false)); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') menus.forEach((m) => (m.open = false)); });
</script>
