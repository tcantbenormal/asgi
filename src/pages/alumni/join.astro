---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { site } from '../../config/site';
const sectors = ['Government', 'Private', 'NGO / UN', 'Academia', 'Freelance', 'Student'];
const provinces = ['Punjab', 'Sindh', 'Khyber Pakhtunkhwa', 'Balochistan', 'Gilgit-Baltistan', 'Azad Jammu & Kashmir', 'Islamabad Capital Territory'];
---
<Base title="Your profile" description="Build a profile that doubles as your portfolio: CV, projects, publications, experience and links." rail={false} noindex>
  <div class="wrap" style="max-width:980px">
    <PageHead eyebrow="Account" title="Your profile and portfolio" lead="Fill what applies, save. Your page lives at a short link you choose. The cabinet approves new profiles, usually within a few days. Come back any time to edit." />

    <form id="editor" class="form" hidden>
      <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap">
        <p id="who" class="muted" style="margin:0"></p>
        <button type="button" class="btn btn-ghost btn-sm" id="signout">Sign out</button>
      </div>
      <p id="state" class="status" hidden></p>

      <div class="tabs" role="group" aria-label="I am" style="margin-top:.25rem">
        <button type="button" data-mode="student">Current student</button>
        <button type="button" data-mode="alumni">Graduate</button>
      </div>
      <p class="muted" id="mode-hint" style="margin:0;font-size:.88rem"></p>

      <fieldset>
        <legend>Identity</legend>
        <div class="row">
          <label>Full name <input name="name" required maxlength="80" /></label>
          <label>Short link <span style="display:flex;align-items:center;gap:.3rem;font-weight:400"><span class="muted" id="origin"></span>/<input name="username" placeholder="fahadkarim" pattern="[a-z0-9][a-z0-9-]{2,29}" title="3 to 30 lowercase letters, digits or hyphens" style="flex:1" /></span></label>
        </div>
        <div class="row">
          <label>Photo <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" /></label>
          <label>CV (PDF, max 5 MB) <input type="file" name="cv" accept="application/pdf" /></label>
        </div>
        <div class="row-3">
          <label>Batch <input name="batch" placeholder="2021-25" required pattern="\d{4}-\d{2}" /></label>
          <label>Degree from the institute <input name="degree" placeholder="BS Geoinformatics" required /></label>
          <label data-only="alumni">Sector <select name="sector" required><option value="">Choose…</option>{sectors.map((s) => <option>{s}</option>)}</select></label>
        </div>
        <div class="row">
          <label>Current role <input name="role" placeholder="GIS Analyst" required /></label>
          <label>Organisation <input name="organization" placeholder="SUPARCO" required /></label>
        </div>
      </fieldset>

      <fieldset>
        <legend>Location</legend>
        <div class="row-3">
          <label>City <input name="city" required /></label>
          <label>Country <input name="country" required /></label>
          <label>Province (if Pakistan) <select name="province"><option value="">—</option>{provinces.map((p) => <option>{p}</option>)}</select></label>
        </div>
        <div class="row-3" data-only="alumni">
          <label>Latitude <input name="lat" type="number" step="any" min="-90" max="90" required /></label>
          <label>Longitude <input name="lng" type="number" step="any" min="-180" max="180" required /></label>
          <label>Map pin
            <span style="display:flex;gap:.5rem;flex-wrap:wrap">
              <button type="button" class="btn btn-primary btn-sm" id="locate">Use my location</button>
              <button type="button" class="btn btn-ghost btn-sm" id="geocode">Look up city</button>
            </span>
          </label>
        </div>
      </fieldset>

      <fieldset>
        <legend>Links</legend>
        <div class="row">
          <label>LinkedIn <input name="linkedin" type="url" placeholder="https://linkedin.com/in/…" /></label>
          <label>GitHub <input name="github" type="url" placeholder="https://github.com/…" /></label>
        </div>
        <div class="row">
          <label>Portfolio or website <input name="portfolio" type="url" placeholder="https://…" /></label>
          <label>ORCID iD <input name="orcid" placeholder="0000-0002-1825-0097" pattern="\d{4}-\d{4}-\d{4}-\d{3}[\dX]" /></label>
        </div>
        <label>Public contact email (shown on your page) <input name="email_public" type="email" /></label>
      </fieldset>

      <fieldset>
        <legend>Career</legend>
        <label>Skills, comma separated <input name="skills" placeholder="QGIS, Python, Google Earth Engine" /></label>
        <label data-only="alumni">One line of advice for juniors <input name="advice" maxlength="200" /></label>
        <label>Your journey (Markdown allowed) <textarea name="bio" placeholder="How you got from first semester to where you are now. Honest beats polished."></textarea></label>
        <label class="check" data-only="alumni"><input type="checkbox" name="mentor" /> List me as open to mentoring students</label>
      </fieldset>

      <fieldset>
        <legend>Import from LinkedIn</legend>
        <p class="muted" style="margin:0;font-size:.88rem">LinkedIn does not let sites read your profile, but it gives you a copy of your own data. On LinkedIn open Settings &amp; Privacy, Data privacy, <em>Get a copy of your data</em>, tick Profile, Positions, Education and Skills, and request the archive. It arrives by email in about ten minutes. Unzip it and pick the CSV files here. Nothing is uploaded; the files are read in your browser.</p>
        <label>LinkedIn CSV files <input type="file" id="li-files" accept=".csv,text/csv" multiple /></label>
      </fieldset>

      <fieldset>
        <legend>Import from your CV</legend>
        <p class="muted" style="margin:0;font-size:.88rem">Pick your CV as a PDF or Word file and the form fills in what it can find: name, email, links, education, experience and skills. It only fills fields that are still empty, and it guesses, so check every line before you save. The file is read in your browser and is not uploaded; use the CV field above if you also want it on your page.</p>
        <label>CV file (PDF or .docx) <input type="file" id="cv-import" accept=".pdf,.docx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document" /></label>
      </fieldset>

      <fieldset>
        <legend>Experience</legend>
        <div id="exp"></div>
        <button type="button" class="btn btn-ghost btn-sm" data-add="exp" style="justify-self:start">Add position</button>
      </fieldset>

      <fieldset>
        <legend>Education</legend>
        <p class="muted" style="margin:0;font-size:.88rem">All degrees, including the one from the institute and anything in progress.</p>
        <div id="edu"></div>
        <button type="button" class="btn btn-ghost btn-sm" data-add="edu" style="justify-self:start">Add degree</button>
      </fieldset>

      <fieldset>
        <legend>Projects</legend>
        <div style="display:flex;gap:.5rem;flex-wrap:wrap;align-items:center">
          <button type="button" class="btn btn-ghost btn-sm" id="import-github">Import from GitHub</button>
          <span class="muted" style="font-size:.85rem">Pulls your twelve most recently updated public repositories. Edit or remove anything after.</span>
        </div>
        <div id="proj"></div>
        <button type="button" class="btn btn-ghost btn-sm" data-add="proj" style="justify-self:start">Add project</button>
      </fieldset>

      <fieldset>
        <legend>Publications</legend>
        <div style="display:flex;gap:.5rem;flex-wrap:wrap;align-items:center">
          <button type="button" class="btn btn-ghost btn-sm" id="import-orcid">Import from ORCID</button>
          <span class="muted" style="font-size:.85rem">Uses the open OpenAlex index. Needs your ORCID iD above.</span>
        </div>
        <div id="pub"></div>
        <button type="button" class="btn btn-ghost btn-sm" data-add="pub" style="justify-self:start">Add publication</button>
      </fieldset>

      <div style="display:flex;gap:.75rem;align-items:center;flex-wrap:wrap">
        <button class="btn btn-accent" type="submit" id="save">Save profile</button>
        <span class="muted" style="font-size:.88rem">By saving you agree to your profile being published on this site. See the <a href="/privacy">privacy policy</a>.</span>
      </div>
    </form>
  </div>

  <template id="t-pub"><div class="rrow c4">
    <label>Title <input data-k="title" required /></label>
    <label>Venue <input data-k="venue" placeholder="Journal / conference" /></label>
    <label>Year <input data-k="year" placeholder="2025" /></label>
    <label>Link <input data-k="url" type="url" placeholder="https://doi.org/…" /></label>
    <button type="button" class="btn btn-ghost btn-sm" data-remove aria-label="Remove">×</button>
  </div></template>
  <template id="t-edu"><div class="rrow c5">
    <label>Institution <input data-k="institution" required placeholder="NUST, Islamabad" /></label>
    <label>Degree <input data-k="degree" placeholder="MS" /></label>
    <label>Programme <input data-k="program" placeholder="Remote Sensing & GIS" /></label>
    <label>Start <input data-k="start" placeholder="2025" /></label>
    <label>End <input data-k="end" placeholder="2027 or present" /></label>
    <button type="button" class="btn btn-ghost btn-sm" data-remove aria-label="Remove">×</button>
  </div></template>
  <template id="t-exp"><div class="rrow c4">
    <label>Title <input data-k="title" required placeholder="GIS Analyst" /></label>
    <label>Organisation <input data-k="organization" /></label>
    <label>Start <input data-k="start" placeholder="2024-06" /></label>
    <label>End <input data-k="end" placeholder="leave empty if current" /></label>
    <label class="span">Description <input data-k="description" placeholder="One or two lines on what you did" /></label>
    <button type="button" class="btn btn-ghost btn-sm" data-remove aria-label="Remove">×</button>
  </div></template>
  <template id="t-proj"><div class="rrow c3">
    <label>Title <input data-k="title" required /></label>
    <label>Live link <input data-k="url" type="url" placeholder="https://…" /></label>
    <label>Repository <input data-k="repo" type="url" placeholder="https://github.com/…" /></label>
    <label class="span">Description <input data-k="description" /></label>
    <label>Tags <input data-k="tags" placeholder="Leaflet, PostGIS" /></label>
    <button type="button" class="btn btn-ghost btn-sm" data-remove aria-label="Remove">×</button>
  </div></template>

  <script is:inline type="module" define:vars={{ url: site.supabase.url, key: site.supabase.key }}>
    import { createClient } from 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm';
    const sb = createClient(url, key);
    const $ = (id) => document.getElementById(id);
    const editor = $('editor'), state = $('state'), f = editor.elements;
    const say = (el, msg, kind = '') => { el.textContent = msg; el.className = `status ${kind}`; el.hidden = !msg; };
    $('origin').textContent = location.origin;

    $('signout').addEventListener('click', () => sb.auth.signOut().then(() => (location.href = '/')));

    // Repeatable rows: pub, edu, exp, proj
    const addRow = (kind, v = {}) => {
      const row = $(`t-${kind}`).content.firstElementChild.cloneNode(true);
      row.querySelectorAll('[data-k]').forEach((i) => (i.value = Array.isArray(v[i.dataset.k]) ? v[i.dataset.k].join(', ') : v[i.dataset.k] ?? ''));
      row.querySelector('[data-remove]').addEventListener('click', () => row.remove());
      $(kind).appendChild(row);
    };
    const rowKey = (r) => `${(r.degree || r.title || '').toLowerCase().replace(/[^a-z]/g, '')}|${(r.start || '').slice(0, 4)}|${(r.end || '').slice(0, 4)}`;
    const dedupe = (rows) => rows.filter((r, i, a) => a.findIndex((o) => rowKey(o) === rowKey(r)) === i);
    const readRows = (kind) => [...$(kind).querySelectorAll('.rrow')].map((r) => Object.fromEntries([...r.querySelectorAll('[data-k]')].map((i) => [i.dataset.k, i.value.trim()])));
    document.querySelectorAll('[data-add]').forEach((b) => b.addEventListener('click', () => addRow(b.dataset.add)));

    // Imports. GitHub public API, 60 requests per hour per IP, no key. OpenAlex, free, polite pool with an email.
    $('import-github').addEventListener('click', async () => {
      const user = (f.github.value.match(/github\.com\/([^/?#]+)/) || [])[1];
      if (!user) return say(state, 'Add your GitHub profile link first.', 'err');
      const r = await fetch(`https://api.github.com/users/${user}/repos?sort=updated&per_page=12&type=owner`);
      if (!r.ok) return say(state, `GitHub said ${r.status}. Try again in a while.`, 'err');
      const repos = (await r.json()).filter((x) => !x.fork);
      repos.forEach((x) => addRow('proj', { title: x.name, description: x.description || '', url: x.homepage || '', repo: x.html_url, tags: [x.language].filter(Boolean) }));
      say(state, `Imported ${repos.length} repositories. Remove any that do not belong on a portfolio.`, 'ok');
    });
    $('import-orcid').addEventListener('click', async () => {
      const id = f.orcid.value.trim();
      if (!id) return say(state, 'Enter your ORCID iD first.', 'err');
      const r = await fetch(`https://api.openalex.org/works?filter=authorships.author.orcid:https://orcid.org/${id}&per-page=50&select=title,publication_year,primary_location,doi&mailto=portal@asgi.pk`);
      if (!r.ok) return say(state, `OpenAlex said ${r.status}.`, 'err');
      const works = (await r.json()).results || [];
      works.forEach((w) => addRow('pub', { title: w.title, venue: w.primary_location?.source?.display_name || '', year: w.publication_year || '', url: w.doi || '' }));
      say(state, works.length ? `Imported ${works.length} works.` : 'No works found for that ORCID in OpenAlex yet.', works.length ? 'ok' : 'err');
    });

    // Student or graduate. One table: sector "Student" is the status flag, so a student
    // switches to Graduate later in this same editor and keeps everything they entered.
    const CAMPUS = { city: 'Rawalpindi', country: 'Pakistan', province: 'Punjab', lat: '33.6492', lng: '73.0815' };
    const label = (name) => f[name].closest('label').firstChild;
    const setMode = (mode) => {
      const st = mode === 'student';
      editor.dataset.mode = mode;
      document.querySelectorAll('[data-only]').forEach((el) => { el.hidden = el.dataset.only !== mode; });
      document.querySelectorAll('[data-mode]').forEach((b) => b.setAttribute('aria-current', b.dataset.mode === mode));
      label('batch').textContent = st ? 'Batch, admission to expected graduation ' : 'Batch ';
      f.batch.placeholder = st ? '2023-27' : '2021-25';
      label('degree').textContent = st ? 'Programme at the institute ' : 'Degree from the institute ';
      label('role').textContent = st ? 'Role, if any ' : 'Current role ';
      label('organization').textContent = st ? 'Organisation, if any ' : 'Organisation ';
      f.role.placeholder = st ? 'Intern, research assistant, leave empty if none' : 'GIS Analyst';
      f.organization.placeholder = st ? 'Leave empty if none' : 'SUPARCO';
      f.role.required = f.organization.required = f.lat.required = f.lng.required = !st;
      [...f.sector.options].forEach((o) => { if (o.value === 'Student') o.hidden = !st; });
      if (st) {
        f.sector.value = 'Student';
        for (const k of ['city', 'country', 'province', 'lat', 'lng']) if (!f[k].value) f[k].value = CAMPUS[k];
      } else if (f.sector.value === 'Student') f.sector.value = '';
      $('mode-hint').textContent = st
        ? 'Students are in the directory and the forum. The map pin and mentoring open up when you graduate: come back and switch to Graduate.'
        : 'Graduates appear on the alumni map and can offer mentoring. Faculty choose the Academia sector.';
    };
    document.querySelectorAll('[data-mode]').forEach((b) => b.addEventListener('click', () => setMode(b.dataset.mode)));

    // LinkedIn data export. Columns as of 2026; unknown files are ignored.
    const csv = (t) => { const rows = [[]]; let q = false, c = ''; for (let i = 0; i < t.length; i++) { const ch = t[i];
      if (q) { if (ch === '"' && t[i + 1] === '"') { c += '"'; i++; } else if (ch === '"') q = false; else c += ch; }
      else if (ch === '"') q = true; else if (ch === ',') { rows.at(-1).push(c); c = ''; } else if (ch === '\n' || ch === '\r') { if (ch === '\r' && t[i + 1] === '\n') i++; rows.at(-1).push(c); c = ''; rows.push([]); } else c += ch; }
      rows.at(-1).push(c); const [h, ...rest] = rows.filter((r) => r.some((x) => x.trim()));
      return rest.map((r) => Object.fromEntries(h.map((k, i) => [k.trim(), (r[i] ?? '').trim()]))); };
    const months = { jan: '01', feb: '02', mar: '03', apr: '04', may: '05', jun: '06', jul: '07', aug: '08', sep: '09', oct: '10', nov: '11', dec: '12' };
    const ym = (d) => { const m = d.match(/^([A-Za-z]{3})\w* (\d{4})$/); return m ? `${m[2]}-${months[m[1].toLowerCase()] || '01'}` : d; };
    $('li-files').addEventListener('change', async (e) => {
      let n = 0;
      for (const file of e.target.files) {
        const rows = csv(await file.text()), name = file.name.toLowerCase();
        if (name.startsWith('positions')) rows.forEach((r) => { addRow('exp', { title: r['Title'], organization: r['Company Name'], start: ym(r['Started On']), end: ym(r['Finished On']), description: r['Description'].split('\n')[0] }); n++; });
        else if (name.startsWith('education')) rows.forEach((r) => { const [deg, ...prog] = (r['Degree Name'] || '').split(','); addRow('edu', { institution: r['School Name'], degree: deg.trim(), program: prog.join(',').trim(), start: (r['Start Date'] || '').slice(-4), end: (r['End Date'] || '').slice(-4) }); n++; });
        else if (name.startsWith('skills')) { const have = f.skills.value.split(',').map((x) => x.trim()).filter(Boolean); f.skills.value = [...new Set([...have, ...rows.map((r) => r['Name']).filter(Boolean)])].join(', '); n += rows.length; }
        else if (name.startsWith('profile')) { const r = rows[0] || {}; if (!f.name.value) f.name.value = `${r['First Name'] || ''} ${r['Last Name'] || ''}`.trim(); if (!f.bio.value) f.bio.value = r['Summary'] || ''; if (!f.city.value) f.city.value = (r['Geo Location'] || '').split(',')[0]; n++; }
      }
      say(state, n ? `Imported ${n} items from LinkedIn. Check dates and remove anything you do not want public.` : 'No recognised files. Pick Positions.csv, Education.csv, Skills.csv or Profile.csv.', n ? 'ok' : 'err');
      e.target.value = '';
    });

    // CV import: text extracted in the browser, fields guessed, only empty ones filled.
    $('cv-import').addEventListener('change', async (e) => {
      const file = e.target.files[0]; if (!file) return;
      say(state, 'Reading your CV…');
      try {
        const { cvText, parseCv } = await import('/js/cvparse.js');
        const cv = parseCv(await cvText(file));
        let n = 0;
        const put = (k, v) => { if (v && f[k] && !f[k].value) { f[k].value = v; n++; } };
        put('name', cv.name); put('email_public', cv.email); put('orcid', cv.orcid); put('bio', cv.bio);
        put('linkedin', cv.links.linkedin); put('github', cv.links.github); put('portfolio', cv.links.portfolio);
        put('role', cv.role); put('organization', cv.organization);
        if (cv.skills.length) { const have = f.skills.value.split(',').map((x) => x.trim()).filter(Boolean); const merged = [...new Set([...have, ...cv.skills])]; n += merged.length - have.length; f.skills.value = merged.join(', '); }
        // Add only rows that do not match an existing one on years and degree or title.
        const eduKeys = new Set(readRows('edu').map(rowKey)), expKeys = new Set(readRows('exp').map(rowKey));
        cv.education.forEach((v) => { if (!eduKeys.has(rowKey(v))) { addRow('edu', v); eduKeys.add(rowKey(v)); n++; } });
        cv.experience.forEach((v) => { if (!expKeys.has(rowKey(v))) { addRow('exp', v); expKeys.add(rowKey(v)); n++; } });
        const arid = cv.education.find((x) => /arid|pmas/i.test(x.institution));
        if (arid) { put('degree', [arid.degree, arid.program].filter(Boolean).join(' ')); if (arid.start && arid.end && /^\d{4}$/.test(arid.end)) put('batch', `${arid.start}-${arid.end.slice(2)}`); }
        say(state, n ? `Filled ${n} items from your CV: ${cv.education.length} education, ${cv.experience.length} experience, ${cv.skills.length} skills. Check dates, titles and organisations; CV layouts vary and the guesses are rough.` : 'Could not find anything usable in that file. Fill the form by hand or try the LinkedIn export.', n ? 'ok' : 'err');
      } catch (err) { say(state, err.message, 'err'); }
      e.target.value = '';
    });

    // Location
    $('locate').addEventListener('click', () => {
      if (!navigator.geolocation) return say(state, 'Your browser does not support location. Use "Look up city" instead.', 'err');
      say(state, 'Waiting for location permission…');
      navigator.geolocation.getCurrentPosition(async (pos) => {
        const lat = pos.coords.latitude, lng = pos.coords.longitude;
        f.lat.value = lat.toFixed(4); f.lng.value = lng.toFixed(4);
        try {
          const r = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&zoom=10&lat=${lat}&lon=${lng}`, { headers: { Accept: 'application/json' } });
          const a = (await r.json()).address || {};
          if (!f.city.value) f.city.value = a.city || a.town || a.village || a.county || a.state || '';
          if (!f.country.value) f.country.value = a.country || '';
          if (!f.province.value && a.state) [...f.province.options].forEach((o) => { if (a.state.includes(o.value.split(' ')[0]) && o.value) f.province.value = o.value; });
        } catch {}
        say(state, 'Pinned to your current location. Adjust if you want to show a different city.', 'ok');
      }, (err) => say(state, err.code === 1 ? 'Location permission denied. Use "Look up city" instead.' : 'Could not get location. Use "Look up city" instead.', 'err'), { timeout: 10000 });
    });
    $('geocode').addEventListener('click', async () => {
      const q = encodeURIComponent(`${f.city.value}, ${f.country.value}`);
      const r = await fetch(`https://nominatim.openstreetmap.org/search?format=json&limit=1&q=${q}`, { headers: { Accept: 'application/json' } });
      const [hit] = await r.json();
      if (!hit) return say(state, 'Place not found. Enter coordinates manually.', 'err');
      f.lat.value = Number(hit.lat).toFixed(4); f.lng.value = Number(hit.lon).toFixed(4);
      say(state, `Pinned to ${hit.display_name}`, 'ok');
    });

    // Load existing profile
    const fill = (p) => {
      for (const k of ['name','username','batch','degree','sector','role','organization','city','country','province','lat','lng','linkedin','github','portfolio','orcid','email_public','advice','bio']) f[k].value = p[k] ?? '';
      f.skills.value = (p.skills ?? []).join(', ');
      f.mentor.checked = !!p.mentor;
      setMode(p.sector === 'Student' ? 'student' : 'alumni');
      $('who').dataset.photo = p.photo_url || '';
      for (const k of ['pub','edu','exp','proj']) $(k).innerHTML = '';
      (p.publications ?? []).forEach((v) => addRow('pub', v));
      (p.education ?? []).forEach((v) => addRow('edu', v));
      (p.experience ?? []).forEach((v) => addRow('exp', v));
      (p.projects ?? []).forEach((v) => addRow('proj', v));
      const path = p.username || p.slug;
      say(state, p.approved ? `Your page is live at ${location.origin}/${path}. Saved edits appear there within about five minutes.` : `Saved and waiting for cabinet approval. Your page will be ${location.origin}/${path}.`, p.approved ? 'ok' : '');
    };
    const { data: { session } } = await sb.auth.getSession();
    if (!session) location.replace('/account?next=/alumni/join');
    if (session) {
      editor.hidden = false;
      $('who').textContent = `Signed in as ${session.user.email}`;
      const { data } = await sb.from('profiles').select('*').eq('user_id', session.user.id).maybeSingle();
      if (data) fill(data); else {
        const m = session.user.user_metadata || {};
        f.name.value = m.full_name || m.name || '';
        addRow('edu'); addRow('exp');
        setMode(new URLSearchParams(location.search).get('as') === 'student' ? 'student' : 'alumni');
      }
    }

    // Upload helper
    const upload = async (bucket, file, name) => {
      const path = `${session.user.id}/${name}`;
      const { error } = await sb.storage.from(bucket).upload(path, file, { upsert: true, contentType: file.type });
      if (error) throw new Error(`${bucket} upload failed: ${error.message}`);
      return sb.storage.from(bucket).getPublicUrl(path).data.publicUrl + `?v=${Date.now()}`;
    };

    // Save
    editor.addEventListener('submit', async (e) => {
      e.preventDefault();
      $('save').disabled = true; say(state, 'Saving…');
      try {
        const extra = {};
        if (f.photo.files[0]) {
          if (f.photo.files[0].size > 2 * 1024 * 1024) throw new Error('Photo must be under 2 MB.');
          extra.photo_url = await upload('avatars', f.photo.files[0], `avatar.${f.photo.files[0].name.split('.').pop().toLowerCase()}`);
        }
        else if (!$('who').dataset.photo && (session.user.user_metadata?.avatar_url || session.user.user_metadata?.picture)) extra.photo_url = session.user.user_metadata.avatar_url || session.user.user_metadata.picture;
        if (f.cv.files[0]) {
          if (f.cv.files[0].size > 5 * 1024 * 1024) throw new Error('CV must be under 5 MB.');
          extra.cv_url = await upload('cv', f.cv.files[0], 'cv.pdf');
        }
        const row = {
          user_id: session.user.id,
          name: f.name.value.trim(), username: f.username.value.trim().toLowerCase() || null,
          batch: f.batch.value.trim(), degree: f.degree.value.trim(), sector: f.sector.value,
          role: f.role.value.trim(), organization: f.organization.value.trim(),
          city: f.city.value.trim(), country: f.country.value.trim(), province: f.province.value || null,
          lat: Number(f.lat.value), lng: Number(f.lng.value),
          linkedin: f.linkedin.value || null, github: f.github.value || null, portfolio: f.portfolio.value || null,
          orcid: f.orcid.value.trim() || null, email_public: f.email_public.value || null,
          skills: f.skills.value.split(',').map((s) => s.trim()).filter(Boolean),
          advice: editor.dataset.mode === 'student' ? null : f.advice.value.trim() || null, bio: f.bio.value.trim() || null,
          mentor: editor.dataset.mode === 'student' ? false : f.mentor.checked,
          publications: readRows('pub').filter((p) => p.title),
          education: dedupe(readRows('edu').filter((p) => p.institution)),
          experience: dedupe(readRows('exp').filter((p) => p.title)).map((p) => ({ ...p, current: !p.end })),
          projects: readRows('proj').filter((p) => p.title).map((p) => ({ ...p, tags: p.tags.split(',').map((s) => s.trim()).filter(Boolean) })),
          ...extra,
        };
        const { data, error } = await sb.from('profiles').upsert(row, { onConflict: 'user_id' }).select().single();
        if (error) throw new Error(error.message.includes('profiles_username') ? 'That short link is taken or not allowed. Pick another.' : error.message);
        fill(data);
      } catch (err) {
        say(state, err.message, 'err');
      } finally {
        $('save').disabled = false;
      }
    });
  </script>
  <style>
    .rrow { display: grid; gap: 0.5rem; align-items: end; padding: 0.75rem; border: 1px dashed var(--line); border-radius: 8px; margin-bottom: 0.5rem; }
    .rrow.c3 { grid-template-columns: 1fr 1fr 1fr auto; }
    .rrow.c4 { grid-template-columns: 2fr 1fr 80px 2fr auto; }
    .rrow.c5 { grid-template-columns: 2fr 1fr 2fr 80px 110px auto; }
    .rrow .span { grid-column: 1 / -2; }
    @media (max-width: 760px) { .rrow, .rrow.c3, .rrow.c4, .rrow.c5 { grid-template-columns: 1fr; } .rrow .span { grid-column: auto; } }
  </style>
</Base>
