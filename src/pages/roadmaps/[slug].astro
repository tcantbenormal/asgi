---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Comments from '../../components/Comments.astro';
import AlumniCard from '../../components/AlumniCard.astro';

export async function getStaticPaths() {
  const roadmaps = await getCollection('roadmaps');
  return roadmaps.map((r) => ({ params: { slug: r.id }, props: { r } }));
}
const { r } = Astro.props;
const { Content } = await render(r);
// Alumni whose skills overlap the track's tools, and the software pages for those tools.
const norm = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
const tools = r.data.tools.map(norm);
const hit = (s: string) => tools.some((t) => { const k = norm(s); return k === t || k.includes(t) || t.includes(k); });
const onTrack = (await getCollection('alumni')).filter((a) => a.data.sector !== 'Student').map((a) => ({ a, n: a.data.skills.filter(hit).length })).filter((x) => x.n > 0).sort((x, y) => y.n - x.n).slice(0, 6);
const software = (await getCollection('resources')).filter((x) => x.data.kind === 'software' && hit(x.data.name));
---
<Base title={r.data.title} description={r.data.summary}>
  <Crumbs items={[["/roadmaps", "Roadmaps"], r.data.title]} />
  <header class="page-head">
    <div class="eyebrow">Roadmap · Demand: {r.data.demand}</div>
    <h1>{r.data.title}</h1>
    <p class="lead">{r.data.summary}</p>
    <div class="tags" style="margin-top:1rem">{r.data.tools.map((t) => <span class="tag grey">{t}</span>)}</div>
    {r.data.roles.length > 0 && <p class="muted" style="margin:.9rem 0 0;font-size:.92rem"><strong>Job titles:</strong> {r.data.roles.join(' · ')}</p>}
    {r.data.employers.length > 0 && <p class="muted" style="margin:.3rem 0 0;font-size:.92rem"><strong>Who hires:</strong> {r.data.employers.join(' · ')}</p>}
  </header>
  <div class="prose" style="margin-bottom:2rem"><Content /></div>
  <h2>Stages</h2>
  <ol class="stages" style="list-style:none;padding:0;margin:0">
    {r.data.stages.map((s) => (
      <li class="stage">
        <h3>{s.name}</h3>
        <div class="duration">{s.duration}</div>
        {s.outcome && <p class="outcome"><strong>By the end you can:</strong> {s.outcome}</p>}
        <ul>{s.skills.map((k) => <li>{k}</li>)}</ul>
        {s.project && <p class="project"><strong>Prove it:</strong> {s.project}</p>}
        {s.resources.length > 0 && (
          <table class="res-table">
            <thead><tr><th>Resource</th><th>Type</th><th>Cost</th><th>Time</th><th>What you get</th></tr></thead>
            <tbody>{s.resources.map((x) => (
              <tr><td><a href={x.url} rel="noopener">{x.label}</a></td><td>{x.kind}</td><td>{x.cost}</td><td>{x.hours ?? ''}</td><td>{x.gives ?? ''}</td></tr>
            ))}</tbody>
          </table>
        )}
      </li>
    ))}
  </ol>
  {software.length > 0 && (
    <section class="section" style="padding-top:2rem">
      <h2>Software for this track</h2>
      <div class="grid">{software.map((x) => (
        <article class="card"><div class="res-head">{x.data.image && <img class="res-logo" src={x.data.image} alt="" width="40" height="40" loading="lazy" />}<div><span class="tag grey">{x.data.category}</span><h3><a href={`/resources/${x.id}`}>{x.data.name}</a></h3></div></div><p>{x.data.description}</p></article>
      ))}</div>
    </section>
  )}
  <section class="section" style="padding-top:2rem">
    <h2>Alumni on this track</h2>
    {onTrack.length ? <div class="grid">{onTrack.map(({ a }) => <AlumniCard a={a} />)}</div> : <p class="empty-state">No graduate lists these tools yet. <a href="/join">Add your profile</a> with your skills to appear here.</p>}
  </section>
  <Comments />
</Base>
