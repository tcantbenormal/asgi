---
// Author avatar (from the alumni directory when the name matches, else initials), date and reading time.
import { getCollection } from 'astro:content';
import Avatar from './Avatar.astro';
interface Props { author: string; date: Date; body?: string; sm?: boolean }
const { author, date, body = '', sm = false } = Astro.props;
const norm = (s: string) => s.toLowerCase().replace(/[^a-z]/g, '');
const person = (await getCollection('alumni')).find((a) => norm(a.data.name) === norm(author));
const minutes = Math.max(1, Math.round(body.split(/\s+/).filter(Boolean).length / 200));
const fmt = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<div class:list={['byline', { sm }]}>
  <Avatar name={author} photo={person?.data.photo} />
  <div>
    <b>{person ? <a href={`/${person.id}`}>{author}</a> : author}</b>
    <small>{fmt} · {minutes} min read</small>
  </div>
</div>
<style>
  .byline { display: flex; gap: 0.6rem; align-items: center; font-size: 0.9rem; }
  .byline :global(.avatar) { width: 36px; height: 36px; font-size: 0.85rem; }
  .byline.sm :global(.avatar) { width: 28px; height: 28px; font-size: 0.7rem; }
  .byline b { display: block; font-weight: 600; color: var(--navy); line-height: 1.2; } .byline b a { color: inherit; text-decoration: none; }
  .byline small { color: var(--ink-3); font-size: 0.8rem; }
</style>
