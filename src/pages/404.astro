---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" rail={false} noindex>
  <div class="wrap" style="text-align:center;padding:6rem 0">
    <div class="eyebrow">404</div>
    <h1>Off the map</h1>
    <p class="lead" style="margin-inline:auto">That page does not exist or has moved.</p>
    <p><a href="/" class="btn btn-primary">Back to home</a> <a href="/search" class="btn btn-ghost">Search</a></p>
  </div>
</Base>
