---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Avatar from '../components/Avatar.astro';
import AlumniMap from '../components/AlumniMap.astro';
import Comments from '../components/Comments.astro';
import { site } from '../config/site';

export async function getStaticPaths() {
  const alumni = await getCollection('alumni');
  return alumni.map((a) => ({ params: { username: a.id }, props: { a } }));
}
const { a } = Astro.props;
const d = a.data;
const { Content } = await render(a);
const icons = {
  linkedin: 'M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z',
  github: 'M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3',
  globe: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm6.9 9h-2.95a15.6 15.6 0 0 0-1.38-5.4A8.03 8.03 0 0 1 18.9 11zM12 4.04c.83 1.2 1.48 2.98 1.84 4.96h-3.68c.36-1.98 1.01-3.76 1.84-4.96zM4.26 14a7.97 7.97 0 0 1 0-4h3.38a16.4 16.4 0 0 0 0 4H4.26zm.84 2h2.95c.32 1.9.78 3.6 1.38 5.4A8.03 8.03 0 0 1 5.1 16zm2.95-8H5.1a8.03 8.03 0 0 1 4.33-5.4C8.83 4.4 8.37 6.1 8.05 8zM12 19.96c-.83-1.2-1.48-2.98-1.84-4.96h3.68c-.36 1.98-1.01 3.76-1.84 4.96zM14.34 14H9.66a14.7 14.7 0 0 1 0-4h4.68a14.7 14.7 0 0 1 0 4zm.25 7.4c.6-1.8 1.06-3.5 1.38-5.4h2.95a8.03 8.03 0 0 1-4.33 5.4zM16.36 14a16.4 16.4 0 0 0 0-4h3.38a7.97 7.97 0 0 1 0 4h-3.38z',
  mail: 'M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z',
  doc: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm4 18H6V4h7v5h5v11zM8 12h8v2H8zm0 4h8v2H8z',
  orcid: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM8.3 16.9H6.8V8.1h1.5v8.8zm-.75-9.9a.95.95 0 1 1 0-1.9.95.95 0 0 1 0 1.9zM10 8.1h3.3c3.3 0 4.7 2.3 4.7 4.4 0 2.3-1.8 4.4-4.7 4.4H10V8.1zm1.5 1.3v6.2h1.8c2.7 0 3.2-2 3.2-3.1 0-1.7-1.1-3.1-3.3-3.1h-1.7z',
};
const links = [
  ['CV', d.cv, icons.doc, true],
  ['LinkedIn', d.linkedin, icons.linkedin, false],
  ['GitHub', d.github, icons.github, false],
  ['Portfolio', d.portfolio, icons.globe, false],
  ['ORCID', d.orcid ? `https://orcid.org/${d.orcid}` : '', icons.orcid, false],
  ['Email', d.email ? `mailto:${d.email}` : '', icons.mail, false],
].filter(([, href]) => href) as [string, string, string, boolean][];
const current = d.experience.find((e) => e.current);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: d.name,
  jobTitle: d.role,
  worksFor: { '@type': 'Organization', name: d.organization },
  alumniOf: [{ '@type': 'CollegeOrUniversity', name: site.university }, ...d.education.map((e) => ({ '@type': 'CollegeOrUniversity', name: e.institution }))],
  address: { '@type': 'PostalAddress', addressLocality: d.city, addressCountry: d.country },
  ...(d.photo ? { image: d.photo } : {}),
  ...(d.email ? { email: d.email } : {}),
  sameAs: [d.linkedin, d.github, d.portfolio, d.orcid ? `https://orcid.org/${d.orcid}` : ''].filter(Boolean),
};
---
<Base title={d.name} description={`${d.name}, ${d.role} at ${d.organization}. ${d.degree}, batch ${d.batch}.${d.skills.length ? ' Skills: ' + d.skills.slice(0, 6).join(', ') + '.' : ''}`}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <section class="profile-band">
    <div class="inner">
      <Avatar name={d.name} photo={d.photo} lg />
      <div style="flex:1;min-width:260px">
        <div class="eyebrow">{d.degree} · Batch {d.batch}</div>
        <h1>{d.name}</h1>
        <p class="lead" style="font-size:1.05rem;margin:0">{d.role}, {d.organization}</p>
        <div class="tags" style="margin-top:.6rem">
          <span class="tag grey">{d.sector}</span>
          <span class="tag grey">{d.city}, {d.country}</span>
          {d.mentor && <span class="tag">Open to mentoring</span>}
        </div>
        <div class="profile-links">
          {links.map(([label, href, path, primary]) => (
            <a class:list={['btn', 'btn-sm', primary ? 'btn-primary' : 'btn-ghost']} href={href} rel="noopener" target={href.startsWith('mailto') ? undefined : '_blank'}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={path} /></svg>{label}
            </a>
          ))}
          {d.mentor && <a class="btn btn-accent btn-sm" href="/mentorship">Request mentorship</a>}
          <button class="btn btn-ghost btn-sm" id="share" type="button">Copy link</button>
        </div>
      </div>
    </div>
  </section>

  <div style="display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:2.5rem;align-items:start" class="profile-grid">
    <div>
      {d.advice && <blockquote class="prose" style="margin-top:0"><p style="margin:0">“{d.advice}”</p></blockquote>}
      <div class="prose"><Content /></div>

      {d.experience.length > 0 && (
        <section class="psec">
          <h2>Experience</h2>
          <ol class="vt">
            {d.experience.map((e) => (
              <li>
                <div class="when">{[e.start, e.current ? 'present' : e.end].filter(Boolean).join(' – ')}</div>
                <h3>{e.title}{e.organization && <span class="muted"> · {e.organization}</span>}</h3>
                {e.description && <p>{e.description}</p>}
              </li>
            ))}
          </ol>
        </section>
      )}

      {d.education.length > 0 && (
        <section class="psec">
          <h2>Education</h2>
          <ol class="vt">
            {d.education.map((e) => (
              <li>
                <div class="when">{[e.start, e.end].filter(Boolean).join(' – ')}</div>
                <h3>{[e.degree, e.program].filter(Boolean).join(' ')}</h3>
                <p>{e.institution}</p>
              </li>
            ))}
          </ol>
        </section>
      )}

      {d.projects.length > 0 && (
        <section class="psec">
          <h2>Projects</h2>
          <div class="grid">
            {d.projects.map((p) => (
              <article class="card">
                <h3>{p.url ? <a href={p.url} rel="noopener" target="_blank">{p.title}</a> : p.title}</h3>
                {p.description && <p>{p.description}</p>}
                {p.tags.length > 0 && <div class="tags">{p.tags.map((t) => <span class="tag grey">{t}</span>)}</div>}
                {p.repo && <div class="foot"><a class="btn btn-ghost btn-sm" href={p.repo} rel="noopener" target="_blank">Source</a></div>}
              </article>
            ))}
          </div>
        </section>
      )}

      {d.publications.length > 0 && (
        <section class="psec">
          <h2>Publications</h2>
          <ul class="pubs">
            {d.publications.map((p) => (
              <li>
                {p.url ? <a href={p.url} rel="noopener" target="_blank">{p.title}</a> : <strong>{p.title}</strong>}
                {(p.venue || p.year) && <small>{[p.venue, p.year].filter(Boolean).join(' · ')}</small>}
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
    <aside style="display:grid;gap:1.25rem">
      {d.skills.length > 0 && (
        <div class="card">
          <h3 style="font-size:.95rem">Skills</h3>
          <div class="tags">{d.skills.map((s) => <span class="tag grey">{s}</span>)}</div>
        </div>
      )}
      <AlumniMap alumni={[a]} interactive={false} />
      <div class="card" style="font-size:.88rem">
        <dl class="facts">
          {current && <><dt>Now</dt><dd>{current.title}{current.organization && `, ${current.organization}`}</dd></>}
          <dt>Based in</dt><dd>{d.city}{d.province && `, ${d.province}`}, {d.country}</dd>
          <dt>Page</dt><dd><code style="font-family:var(--mono);font-size:.82rem">/{a.id}</code></dd>
        </dl>
      </div>
    </aside>
  </div>
  <Comments />
  <script>
    document.getElementById('share')?.addEventListener('click', async (e) => {
      const b = e.currentTarget as HTMLButtonElement;
      await navigator.clipboard.writeText(location.href);
      b.textContent = 'Copied';
      setTimeout(() => (b.textContent = 'Copy link'), 1500);
    });
  </script>
  <style>@media (max-width: 800px) { .profile-grid { grid-template-columns: 1fr !important; } }</style>
</Base>
