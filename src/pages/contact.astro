---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../config/site';
---
<Base title="Contact" description={`Contact the ${site.name}.`}>
  <PageHead eyebrow="Society" title="Contact" lead="For profile updates, broken links, event proposals, sponsorships, or anything else." />
  <div class="prose">
    <dl class="facts">
      <dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
      <dt>Address</dt><dd>{site.department}, {site.university}</dd>
      {site.social.linkedin && <><dt>LinkedIn</dt><dd><a href={site.social.linkedin}>{site.social.linkedin}</a></dd></>}
      {site.social.facebook && <><dt>Facebook</dt><dd><a href={site.social.facebook}>{site.social.facebook}</a></dd></>}
      {site.social.instagram && <><dt>Instagram</dt><dd><a href={site.social.instagram}>{site.social.instagram}</a></dd></>}
    </dl>
    <h2>Sponsorship</h2>
    <p>Survey firms, drone operators, software resellers and training providers can sponsor the portal or a specific event. Sponsors get a placement on the site and a mention at the event. Write to the email above with the subject line “Sponsorship”.</p>
    <h2>Takedown requests</h2>
    <p>If you are listed on this site and want your profile changed or removed, email us from the address you registered with. We act within seven days.</p>
  </div>
</Base>
