// Cloudflare Workers static assets: serves the Astro build output.
// worker.js runs first only to redirect www to the bare domain; assets do the rest.
{
  "name": "asgi",
  "main": "worker.js",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
